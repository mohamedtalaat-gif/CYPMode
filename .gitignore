.venv/
.venv-boltz/
.venv-openfold3/
.conda-openadmet-models/
__pycache__/
*.pyc
.pytest_cache/

# local symlinks into .venv's bundled Streamlit skill doc — broken on a
# fresh clone since .venv isn't committed; not project content
.agents/
.claude/

.DS_Store

# full external clones with their own git history — never narrow this to a
# subdirectory, that would either vacuum in an unrelated repo's history or
# create a broken embedded-repo/gitlink entry
third_party/

# Boltz-2 model weights/CCD cache (~7.6GB) — documented in README, not committed
third_party/boltz_cache/

# OpenFold3-preview model parameters (~2.1GB) — real, freely downloadable
# (see README.md), not committed for the same reason Boltz-2's weights aren't
.openfold3-cache/

# Boltz-2 run outputs: MSA downloads, predicted structures, confidence/affinity
# JSON — regenerated by cypmode/validation, not committed. The small numeric
# summaries derived from them (in data/structure_track/outputs/, docs/) are
# what's tracked.
data/structure_track/outputs/out/
data/structure_track/outputs/*.log
